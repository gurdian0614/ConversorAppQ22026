<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ConversorAppQ22026.ViewModels"
             x:Class="ConversorAppQ22026.Views.LongitudPage"
             Title="📏 Longitud">
    <ContentPage.BindingContext>
        <vm:LongitudViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Border BackgroundColor="#1565C0" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout>
                    <Label Text="📏" FontSize="40" HorizontalOptions="Center" />
                    <Label Text="Conversor de Longitud" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Tipo de conversión" FontSize="14" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding TiposConversion}" SelectedItem="{Binding TipoConversion}" Title="Seleciona una conversión" />

            <Label Text="Valor a convertir" FontSize="14" FontAttributes="Bold" />
            <Entry Placeholder="Ej: 500" Text="{Binding Valor}" Keyboard="Numeric" ReturnCommand="{Binding ConvertirCommand}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="🔄 Convertir" Command="{Binding ConvertirCommand}" BackgroundColor="#1565C0" TextColor="White" CornerRadius="10" HeightRequest="50" />

                <Button Grid.Column="1" Text="🗑 Limpiar" Command="{Binding LimpiarCommand}" BackgroundColor="#BDBDBD" TextColor="Black" CornerRadius="10" HeightRequest="50" />
            </Grid>

            <Border Background="#F0F4FF" Padding="20" IsVisible="{Binding Resultado,Converter={StaticResource StringToBoolConverter}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Label Text="{Binding Resultado}" FontSize="22" FontAttributes="Bold" TextColor="#0D47A1"
                        HorizontalOptions="Center"/>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>